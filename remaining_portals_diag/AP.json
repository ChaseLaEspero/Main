      "url": "https://diofe.portal.ap.gov.br/js/consulta_autenticidade.js",
      "content_type": "text/javascript",
      "body_preview": "$(document).ready(function() {\n    $('#btn-autenticidade').click(function() {\n        var hash = $('#hash').val();\n        $('a#download-box img').fadeOut('fast');\n        if (hash != '') {\n            $.ajax({\n                'url': BASE_URL + '/portal/edicoes/consulta_autenticidade/' + hash,\n                'success': function(data) {\n                    if (data.data.error != true) {\n                        carregarImagemAuternticidade(data.data.Edicao.id);\n                    }\n                    $('#infos-edicao').html(data.data.msg);\n                }\n            });\n        } else {\n          $('#infos-edicao').html('');\n        }\n    });\n\n      $('#btn-autenticidade-materia').click(function() {\n        let hash = $('#hashMateria').val();\n        if (hash != '') {\n            $.post({\n                url: BASE_URL + '/portal/edicoes/consulta_aut_materia/',\n                data: {protocolo: hash},\n                success: function(data) {\n                    $('#infos-edicao-materia').html(data.data.msg + '. Clique <a href=\"'+ data.data.url+'\" target=\"_blank\">aqui</a> para visualizar');\n                },\n                error: function(e) {\n                    alert(e.responseJSON.message);\n                }\n            });\n        } else {\n          $('#infos-edicao-materia').html('');\n        }\n    });\n});\n\nfunction carregarImagemAuternticidade(edicao_id) {\n    if (edicao_id > 0) {\n        var url = BASE_URL + ((SUBTEMA) ? '/' + SUBTEMA : '') + '/apifront/portal/edicoes/imagem_diario/' + edicao_id + '/1/imagem';\n        $('a#download-box img').show();\n        var imagem = $('<div class=\"processing\"></div>');\n        $(\"#imagem-diario\").parent().append(imagem);\n        var im = new Image();\n        im.onload = function() {\n            $(\"#imagem-diario\").fadeOut('fast');\n            $(\"#imagem-diario\").attr('src', url).fadeIn('fast');\n            $(\"#imagem-diario\").parent().find(\".processing\").fadeOut('slow', function() {\n                $(this).remove();\n            });\n        }\n        im.src = url;\n        $('a#download-box').attr('href', BASE_URL + ((SUBTEMA) ? '/' + SUBTEMA : '') + '/portal/edicoes/download/' + edicao_id);\n    }\n}\n",
      "body_length": 2185
